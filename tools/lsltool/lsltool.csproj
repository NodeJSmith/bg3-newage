<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Directory holding LSLib.dll and its dependencies: Packed/Tools from an LSLib ExportTool release. -->
    <LSLibDir Condition="'$(LSLibDir)' == ''">$(MSBuildThisFileDirectory)../../vendor/ExportTool/Packed/Tools</LSLibDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(LSLibDir)/*.dll" Exclude="$(LSLibDir)/Divine.dll;$(LSLibDir)/ConverterApp.dll;$(LSLibDir)/StatParser.dll" />
  </ItemGroup>

</Project>
